{
  "headers": [
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, stale-while-revalidate=300"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/events/:id",
      "destination": "/api/events?id=:id"
    },
    {
      "source": "/api/mentors/:id",
      "destination": "/api/mentors?id=:id"
    },
    {
      "source": "/api/users/:id",
      "destination": "/api/users?id=:id"
    },
    {
      "source": "/api/notifications/:id",
      "destination": "/api/notifications?id=:id"
    },
    {
      "source": "/api/applications/:id",
      "destination": "/api/applications?id=:id"
    },
    {
      "source": "/api/projects/:id",
      "destination": "/api/projects?id=:id"
    }
  ]
}
